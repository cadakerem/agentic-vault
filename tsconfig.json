{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES2022",
      "ESNext"
    ],
    "types": [
      "node",
      "jest"
    ],
    "skipLibCheck": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "**/*.ts"
  ]
}